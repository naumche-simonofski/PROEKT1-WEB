<!DOCTYPE html>
<html lang="mk">
<head>
	<meta charset="UTF-8">
	<title>Travel Planner App</title>
	<style>
		:root {
			--p: #0e7c86;
			--p2: #0a5560;
			--acc: #ff8a3d;
			--bg: #f2f7f9;
			--card: #fff;
			--tx: #1d2b33;
			--mut: #66787f;
			--line: #dfe8ec;
			--ok: #2e9e5b;
			--bad: #d64545;
			--r: 16px;
		}

		* {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
		}

		body {
			font-family: "Segoe UI", Roboto, Arial, sans-serif;
			background: var(--bg);
			color: var(--tx);
			line-height: 1.5;
			min-height: 100vh;
			display: flex;
			flex-direction: column;
		}

		button {
			font: inherit;
			cursor: pointer;
			border: 0;
		}

		input,
		select,
		textarea {
			font: inherit;
			color: inherit;
			width: 100%;
			padding: 10px 12px;
			border: 1.5px solid var(--line);
			border-radius: 10px;
			background: #fff;
			outline: none;
			transition: .2s;
		}

		input:focus,
		select:focus,
		textarea:focus {
			border-color: var(--p);
			box-shadow: 0 0 0 3px rgba(14, 124, 134, .15);
		}

		input[type=range] {
			accent-color: var(--p);
		}

		header {
			background: linear-gradient(120deg, var(--p2), var(--p));
			color: #fff;
			position: sticky;
			top: 0;
			z-index: 50;
			box-shadow: 0 2px 14px rgba(0, 0, 0, .18);
		}

		.hwrap {
			max-width: 1180px;
			margin: auto;
			display: flex;
			align-items: center;
			gap: 20px;
			padding: 12px 20px;
			flex-wrap: wrap;
		}

		.logo {
			font-size: 1.35rem;
			font-weight: 800;
			cursor: pointer;
		}

		nav {
			display: flex;
			gap: 6px;
			flex: 1;
			flex-wrap: wrap;
		}

		nav button {
			background: transparent;
			color: #e3f4f6;
			padding: 8px 14px;
			border-radius: 999px;
			font-weight: 600;
			transition: .2s;
		}

		nav button:hover {
			background: rgba(255, 255, 255, .15);
		}

		nav button.active {
			background: #fff;
			color: var(--p2);
		}

		.btn {
			background: var(--acc);
			color: #fff;
			padding: 9px 18px;
			border-radius: 999px;
			font-weight: 700;
			transition: .2s;
		}

		.btn:hover {
			filter: brightness(1.08);
			transform: translateY(-1px);
		}

		.btn.sec {
			background: #e7f0f3;
			color: var(--p2);
		}

		.btn.ghost {
			background: rgba(255, 255, 255, .18);
			color: #fff;
		}

		.btn.danger {
			background: var(--bad);
		}

		.btn.sm {
			padding: 6px 12px;
			font-size: .85rem;
		}

		main {
			flex: 1;
			max-width: 1180px;
			width: 100%;
			margin: auto;
			padding: 26px 20px 50px;
		}

		.hero {
			background: linear-gradient(rgba(10, 85, 96, .8), rgba(14, 124, 134, .8)), url("https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=1200&q=80") center/cover;
			color: #fff;
			text-align: center;
			padding: 64px 20px;
			border-radius: var(--r);
			margin-bottom: 26px;
		}

		.hero h1 {
			font-size: clamp(1.8rem, 4vw, 3rem);
			margin-bottom: 10px;
		}

		.page {
			display: none;
		}

		.page.show {
			display: block;
		}

		h2.sec {
			font-size: 1.6rem;
			margin: 6px 0 16px;
			color: var(--p2);
		}

		.panel {
			background: var(--card);
			border-radius: var(--r);
			padding: 20px;
			box-shadow: 0 4px 18px rgba(20, 60, 70, .08);
			margin-bottom: 24px;
		}

		.filters,
		.formgrid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
			gap: 14px;
			align-items: end;
		}

		label {
			display: block;
			font-size: .85rem;
			font-weight: 600;
			color: var(--mut);
			margin-bottom: 4px;
		}

		.grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
			gap: 22px;
		}

		.card {
			background: var(--card);
			border-radius: var(--r);
			overflow: hidden;
			box-shadow: 0 4px 18px rgba(20, 60, 70, .1);
			transition: .25s;
			display: flex;
			flex-direction: column;
		}

		.card:hover {
			transform: translateY(-6px);
		}

		.card .im {
			height: 170px;
			background-size: cover;
			background-position: center;
			position: relative;
			cursor: pointer;
		}

		.badge {
			position: absolute;
			top: 12px;
			left: 12px;
			background: rgba(255, 255, 255, .92);
			color: var(--p2);
			font-size: .75rem;
			font-weight: 700;
			padding: 4px 10px;
			border-radius: 999px;
		}

		.card .bd {
			padding: 14px 16px;
			display: flex;
			flex-direction: column;
			gap: 6px;
			flex: 1;
		}

		.price {
			font-weight: 800;
			color: var(--acc);
			font-size: 1.15rem;
		}

		.row {
			display: flex;
			gap: 8px;
			margin-top: auto;
			padding-top: 8px;
		}

		.gal-main {
			height: min(52vw, 420px);
			border-radius: var(--r);
			background-size: cover;
			background-position: center;
			position: relative;
			box-shadow: 0 6px 24px rgba(0, 0, 0, .18);
		}

		.gal-main .cap {
			position: absolute;
			bottom: 0;
			left: 0;
			right: 0;
			padding: 16px;
			color: #fff;
			background: linear-gradient(transparent, rgba(0, 0, 0, .7));
			border-radius: 0 0 var(--r) var(--r);
			font-weight: 600;
		}

		.arrow {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			width: 44px;
			height: 44px;
			border-radius: 50%;
			background: rgba(255, 255, 255, .9);
			font-size: 1.3rem;
			color: var(--p2);
		}

		.arrow.l {
			left: 12px;
		}

		.arrow.r {
			right: 12px;
		}

		.thumbs {
			display: flex;
			gap: 10px;
			margin: 12px 0;
			overflow-x: auto;
		}

		.thumbs div {
			width: 96px;
			height: 64px;
			flex: none;
			border-radius: 10px;
			background-size: cover;
			background-position: center;
			cursor: pointer;
			border: 3px solid transparent;
			opacity: .6;
		}

		.thumbs div.on {
			opacity: 1;
			border-color: var(--acc);
		}

		.split {
			display: grid;
			grid-template-columns: 1.2fr 1fr;
			gap: 24px;
		}

		@media (max-width: 820px) {
			.split {
				grid-template-columns: 1fr;
			}
		}

		.comment {
			padding: 10px 12px;
			border-radius: 12px;
			background: #f3f8fa;
			margin-bottom: 10px;
		}

		.post {
			background: var(--card);
			border-radius: var(--r);
			margin-bottom: 18px;
			box-shadow: 0 4px 18px rgba(20, 60, 70, .08);
			overflow: hidden;
		}

		.post .ph {
			height: 160px;
			background-size: cover;
			background-position: center;
		}

		.post .pb {
			padding: 16px 20px;
		}

		.post ol, .post ul {
			margin-left: 20px;
			margin-top: 8px;
		}

		.post li {
			margin-bottom: 4px;
		}

		.post .more {
			display: none;
			margin-top: 10px;
		}

		.post.open .more {
			display: block;
		}

		.opts {
			display: flex;
			flex-wrap: wrap;
			gap: 8px;
		}

		.opts label {
			display: flex;
			align-items: center;
			gap: 6px;
			background: #f3f8fa;
			border: 1.5px solid var(--line);
			padding: 7px 12px;
			border-radius: 999px;
			cursor: pointer;
		}

		.stars {
			font-size: 2rem;
			color: #cdd8dc;
			cursor: pointer;
		}

		.stars span.on {
			color: #ffb300;
		}

		.modal {
			position: fixed;
			inset: 0;
			background: rgba(10, 30, 36, .55);
			display: none;
			align-items: center;
			justify-content: center;
			z-index: 100;
		}

		.modal.show {
			display: flex;
		}

		.mbox {
			background: #fff;
			border-radius: var(--r);
			padding: 26px;
			width: min(400px, 90%);
		}

		#toast {
			position: fixed;
			bottom: 24px;
			left: 50%;
			transform: translateX(-50%) translateY(80px);
			background: #233;
			color: #fff;
			padding: 12px 22px;
			border-radius: 999px;
			transition: .35s;
			z-index: 200;
			opacity: 0;
		}

		#toast.show {
			transform: translateX(-50%);
			opacity: 1;
		}

		footer {
			background: #10343a;
			color: #bcd5d9;
			margin-top: auto;
			padding: 30px 20px 12px;
			text-align: center;
		}
	</style>
</head>
<body>

	<header>
		<div class="hwrap">
			<div class="logo" onclick="go('home')">Travel Planner</div>
			<nav id="nav">
				<button data-page="home" class="active">Почетна</button>
				<button data-page="blog">Блог / Водич</button>
				<button data-page="survey">Анкета</button>
			</nav>
			<div class="user" id="userBox"></div>
		</div>
	</header>

	<main>
		<section id="home" class="page show">
			<div class="hero">
				<h1>Планирај го следното патување </h1>
				<p>Истражувај дестинации, пресметај ги патните трошоци и разгледај галерии.</p>
				<button class="btn" onclick="document.getElementById('dest').scrollIntoView({behavior:'smooth'})">Истражи дестинации</button>
			</div>

			<h2 class="sec" id="dest">Дестинации</h2>
			<div class="panel">
				<div class="filters">
					<div><label>Пребарување</label><input type="text" id="fSearch" placeholder="Град или држава..."></div>
					<div><label>Категорија</label><select id="fCat"></select></div>
					<div><label>Макс. буџет (5 дена): <b id="fBudVal"></b></label><input type="range" id="fBud" min="200" max="3000" step="50" value="3000"></div>
					<div>
						<label>Подредување</label>
						<select id="fSort">
							<option value="name">Име (А–Ш)</option>
							<option value="asc">Цена: ниска → висока</option>
							<option value="desc">Цена: висока → ниска</option>
						</select>
					</div>
				</div>
			</div>

			<details class="panel" id="addBox">
				<summary style="font-weight:700; cursor:pointer; color:var(--p2)">Додади нова дестинација</summary>
				<form id="addForm" style="margin-top:14px">
					<div class="formgrid">
						<div><label>Град *</label><input type="text" id="aName" required></div>
						<div><label>Држава *</label><input type="text" id="aCountry" required></div>
						<div><label>Категорија</label><select id="aCat"></select></div>
						<div><label>Авионска карта (€)</label><input type="number" id="aFlight" value="150" required></div>
						<div><label>Сместување / ноќ (€)</label><input type="number" id="aHotel" value="80" required></div>
						<div><label>Храна / ден (€)</label><input type="number" id="aFood" value="30" required></div>
						<div><label>Активности / ден (€)</label><input type="number" id="aAct" value="20" required></div>
						<div><label>Слика (URL)</label><input type="text" id="aImg" placeholder="https://..."></div>
					</div>
					<button class="btn" type="submit" style="margin-top:10px">Додади</button>
				</form>
			</details>

			<div class="grid" id="cityGrid"></div>

			<h2 class="sec" style="margin-top:34px">Пресметка на патни трошоци</h2>
			<div class="panel">
				<div class="filters">
					<div><label>Дестинација</label><select id="cSel"></select></div>
					<div><label>Број на денови</label><input type="number" id="cDays" min="1" value="5"></div>
					<div><label>Број на патници</label><input type="number" id="cPeople" min="1" value="1"></div>
				</div>
				<div id="cOut"></div>
			</div>
		</section>

		<section id="city" class="page">
			<button class="btn sec" style="margin-bottom:14px" onclick="go('home')">← Назад</button>
			<div id="cityView"></div>
		</section>

		<section id="blog" class="page">
			<h2 class="sec">Блог / водич низ градот</h2>
			<div id="blogList"></div>
		</section>

		<section id="survey" class="page">
			<h2 class="sec">Анкета за импресии</h2>
			<div class="split">
				<div class="panel">
					<form id="svForm">
						<div style="margin-bottom:12px"><label>Вашето име</label><input type="text" id="svName"></div>
						<div style="margin-bottom:12px"><label>Е-пошта</label><input type="email" id="svMail"></div>
						<div style="margin-bottom:12px">
							<label>Како дознавте за сајтот?</label>
							<div class="opts">
								<label><input type="radio" name="svSrc" value="Социјални мрежи" checked> Социјални мрежи</label>
								<label><input type="radio" name="svSrc" value="Пријатели"> Пријатели</label>
								<label><input type="radio" name="svSrc" value="Пребарувач"> Пребарувач</label>
							</div>
						</div>
						<div style="margin-bottom:12px">
							<label>Вкупна оцена</label>
							<div class="stars" id="svStars"></div>
						</div>
						<div style="margin-bottom:12px"><label>Коментар</label><textarea id="svText" rows="3"></textarea></div>
						<button class="btn" type="submit">Испрати</button>
					</form>
				</div>
				<div class="panel">
					<h3 style="color:var(--p2);margin-bottom:10px">Резултати</h3>
					<div id="svResults"></div>
				</div>
			</div>
		</section>
	</main>

	<footer>
		<p>© <span id="yr"></span> Travel Planner App </p>
	</footer>

	<div class="modal" id="loginModal">
		<form class="mbox" id="loginForm">
			<h3 style="margin-bottom:12px;color:var(--p2)">Најава</h3>
			<div style="margin-bottom:10px"><label>Корисничко име</label><input type="text" id="lUser" required></div>
			<div style="margin-bottom:14px"><label>Лозинка</label><input type="password" id="lPass" required minlength="3"></div>
			<div style="display:flex;gap:8px;justify-content:flex-end">
				<button type="button" class="btn sec" onclick="closeLogin()">Откажи</button>
				<button type="submit" class="btn">Најави се</button>
			</div>
		</form>
	</div>

	<div id="toast"></div>

	<script>
		const categories = ["Градски одмор", "Плажа", "Култура", "Природа", "Авантура"];

		let cities = [
			{ id: 1, name: "Охрид", country: "Македонија", cat: "Природа", flight: 60, hotel: 45, food: 20, act: 10, images: ["https://images.unsplash.com/photo-1563297129-e686774a3070?auto=format&fit=crop&w=800&q=80", "https://images.unsplash.com/photo-1590523741831-ab7e8b8f9c7f?auto=format&fit=crop&w=800&q=80"] },
			{ id: 2, name: "Париз", country: "Франција", cat: "Градски одмор", flight: 150, hotel: 130, food: 50, act: 30, images: ["https://images.unsplash.com/photo-1502602898657-3e91760cbb34?auto=format&fit=crop&w=800&q=80", "https://images.unsplash.com/photo-1499856871958-5b9627545d1a?auto=format&fit=crop&w=800&q=80"] },
			{ id: 3, name: "Рим", country: "Италија", cat: "Култура", flight: 130, hotel: 105, food: 40, act: 25, images: ["https://images.unsplash.com/photo-1552832230-c0197dd311b5?auto=format&fit=crop&w=800&q=80", "https://images.unsplash.com/photo-1515542622106-78bda8ba0e5b?auto=format&fit=crop&w=800&q=80"] },
			{ id: 4, name: "Барселона", country: "Шпанија", cat: "Плажа", flight: 140, hotel: 100, food: 40, act: 25, images: ["https://images.unsplash.com/photo-1583422409516-2895a77efded?auto=format&fit=crop&w=800&q=80", "https://images.unsplash.com/photo-1539037116277-4db20889f2d4?auto=format&fit=crop&w=800&q=80"] },
			{ id: 5, name: "Истанбул", country: "Турција", cat: "Култура", flight: 100, hotel: 60, food: 25, act: 15, images: ["https://images.unsplash.com/photo-1524231757912-21f4fe3a7200?auto=format&fit=crop&w=800&q=80", "https://images.unsplash.com/photo-1541432901042-2d8bd64b4a9b?auto=format&fit=crop&w=800&q=80"] },
			{ id: 6, name: "Санторини", country: "Грција", cat: "Плажа", flight: 200, hotel: 170, food: 55, act: 30, images: ["https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=800&q=80", "https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=800&q=80"] },
			{ id: 7, name: "Токио", country: "Јапонија", cat: "Градски одмор", flight: 750, hotel: 115, food: 45, act: 30, images: ["https://images.unsplash.com/photo-1503899036084-c55cdd92da26?auto=format&fit=crop&w=800&q=80", "https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?auto=format&fit=crop&w=800&q=80"] },
			{ id: 8, name: "Интерлакен", country: "Швајцарија", cat: "Авантура", flight: 180, hotel: 160, food: 60, act: 55, images: ["https://images.unsplash.com/photo-1530122037265-a5f1f91d3b99?auto=format&fit=crop&w=800&q=80", "https://images.unsplash.com/photo-1527668752968-14dc70a27c95?auto=format&fit=crop&w=800&q=80"] }
		];

		let nextId = 9, user = "", currentCity = null, currentPicture = 0, rating = 0;
		let comments = {}, votes = {}, surveyAnswers = [];

		function message(t) {
			const b = document.getElementById("toast");
			b.textContent = t; b.classList.add("show");
			setTimeout(() => b.classList.remove("show"), 2500);
		}
		function escapeHtml(s) { return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
		function formatPrice(p) { return "€" + Math.round(p); }
		function calculateTotal(c, d, p) { return (c.flight + (c.hotel + c.food + c.act) * d) * p; }

		function go(page) {
			document.querySelectorAll(".page").forEach(p => p.classList.remove("show"));
			document.getElementById(page).classList.add("show");
			document.querySelectorAll("#nav button").forEach(b => {
				b.classList.toggle("active", b.getAttribute("data-page") === page || (page === "city" && b.getAttribute("data-page") === "home"));
			});
			window.scrollTo(0,0);
		}

		document.getElementById("nav").addEventListener("click", e => e.target.tagName === "BUTTON" && go(e.target.getAttribute("data-page")));

		function openLogin() { document.getElementById("loginModal").classList.add("show"); }
		function closeLogin() { document.getElementById("loginModal").classList.remove("show"); }
		function renderUser() {
			document.getElementById("userBox").innerHTML = user 
				? `<span>👤 <b>${escapeHtml(user)}</b></span> <button class="btn ghost sm" onclick="logout()">Одјава</button>`
				: `<button class="btn" onclick="openLogin()">Најава</button>`;
		}
		function logout() { user = ""; renderUser(); message("Успешно се одјавивте."); }
		document.getElementById("loginForm").addEventListener("submit", e => {
			e.preventDefault();
			user = document.getElementById("lUser").value;
			renderUser(); closeLogin(); message("Добредојде, " + user + "!");
		});

		function fillCategories() {
			const opts = '<option value="">Сите категории</option>' + categories.map(c => `<option value="${c}">${c}</option>`).join('');
			document.getElementById("fCat").innerHTML = opts;
			document.getElementById("aCat").innerHTML = categories.map(c => `<option value="${c}">${c}</option>`).join('');
		}

		function renderCities() {
			const search = document.getElementById("fSearch").value.toLowerCase();
			const cat = document.getElementById("fCat").value;
			const maxB = Number(document.getElementById("fBud").value);
			const sort = document.getElementById("fSort").value;

			document.getElementById("fBudVal").textContent = maxB >= 3000 ? "без ограничување" : formatPrice(maxB);

			let res = cities.filter(c => 
				(search === "" || (c.name + " " + c.country).toLowerCase().includes(search)) &&
				(cat === "" || c.cat === cat) &&
				(maxB >= 3000 || calculateTotal(c, 5, 1) <= maxB)
			);

			if (sort === "asc") res.sort((a,b) => calculateTotal(a,5,1) - calculateTotal(b,5,1));
			else if (sort === "desc") res.sort((a,b) => calculateTotal(b,5,1) - calculateTotal(a,5,1));
			else res.sort((a,b) => a.name.localeCompare(b.name));

			document.getElementById("cityGrid").innerHTML = res.map(c => `
				<div class="card">
					<div class="im" style="background-image:url('${c.images[0]}')" onclick="openCity(${c.id})">
						<span class="badge">${escapeHtml(c.cat)}</span>
					</div>
					<div class="bd">
						<h3>${escapeHtml(c.name)}</h3>
						<div style="color:var(--mut);font-size:.9rem">${escapeHtml(c.country)}</div>
						<div class="price">≈ ${formatPrice(calculateTotal(c, 5, 1))} (5 дена)</div>
						<div class="row">
							<button class="btn sm" onclick="openCity(${c.id})">Отвори</button>
							<button class="btn sec sm" onclick="useCalc(${c.id})">Пресметај</button>
							<button class="btn danger sm" onclick="deleteCity(${c.id})">Избриши</button>
						</div>
					</div>
				</div>
			`).join('') || '<div style="grid-column:1/-1;text-align:center;padding:30px">Нема дестинации.</div>';

			document.getElementById("cSel").innerHTML = cities.map(c => `<option value="${c.id}">${escapeHtml(c.name)}, ${escapeHtml(c.country)}</option>`).join('');
			renderCalc();
		}

		['fSearch', 'fCat', 'fBud', 'fSort'].forEach(id => document.getElementById(id).addEventListener(id === 'fBud' ? 'input' : 'change', renderCities));

		document.getElementById("addForm").addEventListener("submit", e => {
			e.preventDefault();
			if (!user) { message("Прво треба да се најавите."); openLogin(); return; }
			const name = document.getElementById("aName").value.trim();
			const img = document.getElementById("aImg").value.trim() || "https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=800&q=80";

			cities.push({
				id: nextId++, name, country: document.getElementById("aCountry").value.trim(),
				cat: document.getElementById("aCat").value,
				flight: Number(document.getElementById("aFlight").value),
				hotel: Number(document.getElementById("aHotel").value),
				food: Number(document.getElementById("aFood").value),
				act: Number(document.getElementById("aAct").value),
				images: [img]
			});
			e.target.reset(); renderCities(); message("Дестинацијата е додадена.");
		});

		function deleteCity(id) {
			if (!user) { message("Прво треба да се најавите."); openLogin(); return; }
			if (confirm("Избриши ја дестинацијата?")) {
				cities = cities.filter(c => c.id !== id);
				renderCities(); message("Дестинацијата е избришана.");
			}
		}

		function renderCalc() {
			const c = cities.find(x => x.id === Number(document.getElementById("cSel").value));
			if (!c) { document.getElementById("cOut").innerHTML = ""; return; }
			const d = Math.max(1, Number(document.getElementById("cDays").value));
			const p = Math.max(1, Number(document.getElementById("cPeople").value));
			const tot = calculateTotal(c, d, p);
			document.getElementById("cOut").innerHTML = `<div style="margin-top:14px;background:#eaf7f8;padding:14px;border-radius:12px">Вкупно: <b>${formatPrice(tot)}</b> за ${p} лице/а (${d} дена)</div>`;
		}
		['cSel', 'cDays', 'cPeople'].forEach(id => document.getElementById(id).addEventListener('change', renderCalc));
		function useCalc(id) { document.getElementById("cSel").value = id; renderCalc(); document.getElementById("cSel").scrollIntoView({behavior:"smooth"}); }

		function openCity(id) { currentCity = id; currentPicture = 0; renderCity(); go("city"); }
		function renderCity() {
			const c = cities.find(x => x.id === currentCity);
			if (!c) return;
			const key = `${c.id}-${currentPicture}`;
			votes[key] = votes[key] || {like: 0, dislike: 0};
			comments[c.id] = comments[c.id] || [];

			const imgUrl = c.images[currentPicture] || c.images[0];
			const thumbs = c.images.map((img, i) => `<div class="${i === currentPicture ? 'on' : ''}" style="background-image:url('${img}')" onclick="setPicture(${i})"></div>`).join('');

			document.getElementById("cityView").innerHTML = `
				<h2 class="sec">${escapeHtml(c.name)}, ${escapeHtml(c.country)}</h2>
				<div class="gal-main" style="background-image:url('${imgUrl}')">
					${c.images.length > 1 ? '<button class="arrow l" onclick="changePicture(-1)">‹</button><button class="arrow r" onclick="changePicture(1)">›</button>' : ''}
					<div class="cap">Слика ${currentPicture + 1} од ${c.images.length}</div>
				</div>
				<div class="thumbs">${thumbs}</div>
				<div style="display:flex;gap:10px;margin:10px 0">
					<button class="btn sec sm" onclick="vote(1)">👍 ${votes[key].like}</button>
					<button class="btn sec sm" onclick="vote(-1)">👎 ${votes[key].dislike}</button>
				</div>
				<div class="split" style="margin-top:20px">
					<div class="panel">
						<h3>Коментари (${comments[c.id].length})</h3>
						<form id="cmtForm" style="margin:12px 0">
							<textarea id="cmtTxt" rows="2" placeholder="Напиши коментар..."></textarea>
							<button class="btn sm" style="margin-top:6px">Објави</button>
						</form>
						<div>${comments[c.id].map(x => `<div class="comment"><b>${escapeHtml(x.user)}</b>: ${escapeHtml(x.text)}</div>`).join('') || '<div style="color:var(--mut)">Нема коментари.</div>'}</div>
					</div>
					<div class="panel">
						<h3>Брза пресметка</h3>
						<p style="margin-top:8px">Проценети трошоци за 5 дена: <b>${formatPrice(calculateTotal(c, 5, 1))}</b></p>
					</div>
				</div>
			`;

			document.getElementById("cmtForm").addEventListener("submit", e => {
				e.preventDefault();
				if (!user) { message("Најавете се за да коментирате."); openLogin(); return; }
				const txt = document.getElementById("cmtTxt").value.trim();
				if (txt) { comments[c.id].push({user, text: txt}); renderCity(); }
			});
		}

		function setPicture(n) { currentPicture = n; renderCity(); }
		function changePicture(d) {
			const c = cities.find(x => x.id === currentCity);
			currentPicture = (currentPicture + d + c.images.length) % c.images.length;
			renderCity();
		}
		function vote(t) {
			const key = `${currentCity}-${currentPicture}`;
			if (t === 1) votes[key].like++; else votes[key].dislike++;
			renderCity();
		}

