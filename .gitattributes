		function renderBlog() {
			document.getElementById("blogList").innerHTML = posts.map((p, i) => `
				<article class="post" id="post${i}">
					<div class="ph" style="background-image:url('${p.img}')"></div>
					<div class="pb">
						<h3>${p.title}</h3>
						<div style="color:var(--mut);font-size:.9rem;margin-bottom:6px">${p.intro}</div>
						<div class="more"><ol>${p.items.map(it => `<li>${it}</li>`).join('')}</ol></div>
						<button class="btn sm" style="margin-top:10px" onclick="document.getElementById('post${i}').classList.toggle('open')">Прочитај повеќе</button>
					</div>
				</article>
			`).join('');
		}

		function showStars() {
			document.getElementById("svStars").innerHTML = [1,2,3,4,5].map(i => `<span class="${i <= rating ? 'on' : ''}" onclick="setRating(${i})">★</span>`).join('');
		}
		function setRating(r) { rating = r; showStars(); }

		document.getElementById("svForm").addEventListener("submit", e => {
			e.preventDefault();
			if (!rating) { message("Изберете оцена."); return; }
			surveyAnswers.push({ name: document.getElementById("svName").value || "Анонимен", rating, text: document.getElementById("svText").value });
			e.target.reset(); rating = 0; showStars(); renderSurvey(); message("Ви благодариме!");
		});

		function renderSurvey() {
			if (!surveyAnswers.length) { document.getElementById("svResults").innerHTML = '<div style="color:var(--mut)">Нема одговори.</div>'; return; }
			const avg = (surveyAnswers.reduce((a,b) => a + b.rating, 0) / surveyAnswers.length).toFixed(1);
			document.getElementById("svResults").innerHTML = `<p><b>${surveyAnswers.length}</b> одговори | Просек: <b>${avg} ★</b></p>` +
				surveyAnswers.filter(x => x.text).map(x => `<div class="comment"><b>${escapeHtml(x.name)}</b> (${x.rating}★): ${escapeHtml(x.text)}</div>`).join('');
		}

		document.getElementById("yr").textContent = new Date().getFullYear();
